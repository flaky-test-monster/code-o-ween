# ---------------------------------------------------------------------------------------------
# Options shared by create and update
# ---------------------------------------------------------------------------------------------
require_value() {
  [[ $# -ge 2 ]] || die "$1 needs a value"
}

# Reads one option into the caller's color/icon_mode/icon_value/folder_action/folder/
# window_tint variables and reports how many arguments it took in "consumed".
parse_disguise_option() {
  consumed=2
  case "$1" in
    --color) require_value "$@"; color="$2" ;;
    --emoji|--icon|--built-in-icon)
      [[ -z "$icon_mode" ]] || die "choose only one of --emoji, --icon, or --built-in-icon"
      case "$1" in
        --emoji) require_value "$@"; icon_mode=emoji; icon_value="$2" ;;
        --icon) require_value "$@"; icon_mode=image; icon_value="$2" ;;
        --built-in-icon) icon_mode=built-in; icon_value=""; consumed=1 ;;
      esac
      ;;
    --folder|--no-folder)
      [[ -z "$folder_action" ]] || die "use either --folder or --no-folder, once"
      if [[ "$1" == --folder ]]; then require_value "$@"; folder_action="set"; folder="$2"; else folder_action="clear"; consumed=1; fi
      ;;
    --window-color)
      require_value "$@"
      [[ "$2" == on || "$2" == off ]] || die "--window-color needs on or off"
      window_tint="$2"
      ;;
    *) return 1 ;;
  esac
}

validate_disguise_options() {
  local canonical
  if [[ -n "$color" ]]; then
    canonical="$(canonical_color "$color")" || die "unknown color '$color' (run 'code-o-ween colors')"
    color="$canonical"
  fi
  [[ "$icon_mode" != emoji || -n "$icon_value" ]] || die "--emoji needs a value"
  [[ "$icon_mode" != image || -f "$icon_value" ]] || die "icon file not found: $icon_value"
  [[ "$folder_action" != set ]] || folder="$(resolve_folder "$folder")"
}

# ---------------------------------------------------------------------------------------------
# Generated scripts
# ---------------------------------------------------------------------------------------------

# The bundle's CFBundleExecutable. It starts the original executable with the arguments that
# keep this disguise's data apart.
write_launcher() {
  local launcher="$1" original_executable="$2" profile_path="$3" extensions_mode="${4:-shared}" slug="${5:-}"
  local quoted_profile quoted_executable isolation_lines marker_lines=""
  printf -v quoted_profile '%q' "$profile_path"
  printf -v quoted_executable '%q' "$original_executable"

  isolation_lines='mkdir -p "$profile_root/user-data"
args=(--user-data-dir "$profile_root/user-data")'
  if [[ "$extensions_mode" == "isolated" ]]; then
    isolation_lines="$isolation_lines"$'\n''args+=(--extensions-dir "$profile_root/extensions")'
  fi
  isolation_lines="$isolation_lines"$'\n''# Opened from Finder or the Dock: open the pinned folder, if one is set and still exists.
if [[ $# -eq 0 && -f "$profile_root/pinned-folder" ]]; then
  pinned_folder="$(<"$profile_root/pinned-folder")"
  if [[ -d "$pinned_folder" ]]; then
    set -- "$pinned_folder"
  fi
fi
exec "$executable" "${args[@]}" "$@"'

  # The original Electron executable must keep its name: Electron locates
  # "Frameworks/<executable> Helper.app" from it and aborts otherwise.
  # A settings folder that went missing is recreated with its ownership marker, so the other
  # commands keep accepting it; an existing folder is never claimed here.
  [[ -z "$slug" ]] || marker_lines="$(profile_guard_lines "$slug")"
  cat >"$launcher" <<EOF
#!/bin/bash
set -e
executable="\$(cd "\$(dirname "\$0")" && pwd)/"$quoted_executable
if [[ "\${ELECTRON_RUN_AS_NODE:-}" == "1" ]]; then
  exec "\$executable" "\$@"
fi
profile_root=$quoted_profile
$marker_lines
$isolation_lines
EOF
  chmod +x "$launcher"
}

# Lines for a generated script, run before it touches the settings folder: refuse a symbolic
# link and a folder Code-o-ween does not own (the same rules create and update apply, so a
# profile swapped for a link to someone else's folder cannot be used by a launch), and recreate
# a missing folder with its marker and update.mode pinned, so a recovered profile cannot update
# the clone before the next refresh. An existing folder is never claimed.
# Launched from Finder there is no terminal, so refusals also show an alert, unless stderr is a
# terminal or CODE_O_WEEN_NO_ALERT is set (the tests set it).
profile_guard_lines() {
  local slug="$1" quoted_slug
  printf -v quoted_slug '%q' "$slug"
  cat <<EOF
refuse() {
  echo "Code-o-ween: \$1" >&2
  # Launched from Finder there is no terminal to read that, so it is shown as an alert too.
  if [[ ! -t 2 && -z "\${CODE_O_WEEN_NO_ALERT:-}" ]]; then
    /usr/bin/osascript -e "display alert \"Code-o-ween\" message \"\$1\"" >/dev/null 2>&1 || true
  fi
  exit 1
}
if [[ -L "\$profile_root" ]]; then refuse "the settings folder \$profile_root is a symbolic link; refusing to start"; fi
if [[ ! -e "\$profile_root" ]]; then
  mkdir -p "\$profile_root" && printf '%s' $quoted_slug >"\$profile_root/$PROFILE_MARKER"
EOF
  cat <<'EOF'
  mkdir -p "$profile_root/user-data/User"
  [[ -e "$profile_root/user-data/User/settings.json" ]] || printf '{\n  "update.mode": "none"\n}\n' >"$profile_root/user-data/User/settings.json"
EOF
  cat <<EOF
fi
if [[ "\$(cat "\$profile_root/$PROFILE_MARKER" 2>/dev/null)" != $quoted_slug ]]; then
  refuse "\$profile_root was not created by Code-o-ween for $quoted_slug; run: code-o-ween refresh $quoted_slug"
fi
EOF
}

# One command at a time per disguise. Two creates for the same name could otherwise both pass
# the existence check, and the second mv would land its new.app inside the first bundle, with
# both reporting success. mkdir is atomic, which makes the lock folder the lock.
lock_slug() {
  local lock="$1/.lock-$2"
  mkdir "$lock" 2>/dev/null ||
    die "another code-o-ween command is working on '$2'; try again in a moment (if none is, remove $lock)"
  SLUG_LOCK="$lock"
}

unlock_slug() {
  [[ -z "${SLUG_LOCK:-}" ]] || rmdir "$SLUG_LOCK" 2>/dev/null || true
  SLUG_LOCK=""
}
SLUG_LOCK=""

# The terminal shortcut in BIN_ROOT: the disguise's own command-line launcher (code-NAME ...),
# pointed at its settings folder.
write_shortcut() {
  local slug="$1" app="$2"
  local shortcut cli extensions_mode quoted_profile quoted_cli shortcut_tmp extension_lines=""
  shortcut="$(shortcut_for_app "$app" "$slug")"
  assert_shortcut_owned "$slug" "$shortcut"
  mkdir -p "$BIN_ROOT"
  shortcut_tmp="$(mktemp "$BIN_ROOT/.$shortcut.XXXXXX")"
  cli="$(read_metadata "$app" cli "Contents/Resources/app/bin/code")"
  extensions_mode="$(read_metadata "$app" extensions shared)"
  printf -v quoted_profile '%q' "$(profile_for_app "$app" "$slug")"
  printf -v quoted_cli '%q' "$app/$cli"
  if [[ "$extensions_mode" == "isolated" ]]; then
    extension_lines='args+=(--extensions-dir "$profile_root/extensions")'
  fi
  cat >"$shortcut_tmp" <<EOF
#!/bin/bash
# Managed by Code-o-ween: $slug
set -e
profile_root=$quoted_profile
$(profile_guard_lines "$slug")
mkdir -p "\$profile_root/user-data"
args=(--user-data-dir "\$profile_root/user-data")
$extension_lines
exec $quoted_cli "\${args[@]}" "\$@"
EOF
  chmod +x "$shortcut_tmp"
  assert_shortcut_owned "$slug" "$shortcut"
  mv -f "$shortcut_tmp" "$BIN_ROOT/$shortcut"
}

# ---------------------------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------------------------
create_instance() (
  require_macos

  local name="${1:-}"
  [[ -n "$name" ]] || die "create requires a NAME"
  validate_name "$name"
  shift || true

  local color="" icon_mode="" icon_value="" folder_action="" folder="" window_tint="" consumed
  local kind="" extensions_mode="" source="" force="false" trust_source="false"
  while [[ $# -gt 0 ]]; do
    if parse_disguise_option "$@"; then
      shift "$consumed"
      continue
    fi
    case "$1" in
      --app) require_value "$@"; kind="$2"; shift 2 ;;
      --extensions) require_value "$@"; extensions_mode="$2"; shift 2 ;;
      --source) require_value "$@"; source="$2"; shift 2 ;;
      --trust-source) trust_source="true"; shift ;;
      --force) force="true"; shift ;;
      *) die "unknown create option: $1" ;;
    esac
  done
  validate_disguise_options
  [[ -n "$color" ]] || color="$DEFAULT_COLOR"
  [[ -n "$icon_mode" ]] || icon_mode=built-in
  case "$extensions_mode" in ""|shared|isolated) ;; *) die "--extensions must be shared or isolated" ;; esac

  # Which app, and which copy of it.
  local detected
  if [[ -z "$source" ]]; then
    [[ -n "$kind" ]] || kind="vscode"
    load_kind "$kind"
    source="$(default_source_app)"
  fi
  [[ -d "$source/Contents/MacOS" && -f "$source/Contents/Info.plist" ]] || die "not a macOS app bundle: $source"
  source="$(cd "$source" && pwd -P)"
  detected="$(detect_kind "$source")"
  local detected_team=""
  if [[ "$detected" != other ]]; then
    load_kind "$detected"
    detected_team="$KIND_TEAM_ID"
  fi
  if [[ -z "$kind" ]]; then
    kind="$detected"
  elif [[ "$kind" != "$detected" && "$kind" != other && "$detected" != other ]]; then
    # A recognized app under a different recipe is almost certainly a mistake.
    load_kind "$detected"
    die "$(basename "$source") is $KIND_LABEL; pass --app $detected or omit --app"
  fi
  configure_kind_for_source "$kind" "$source"
  # A recognized bundle keeps its publisher requirement under --app other too; only
  # --trust-source relaxes it.
  [[ -z "$detected_team" ]] || KIND_TEAM_ID="$detected_team"
  assert_kind_usable
  is_vscode_style_app "$source" ||
    die "$source is not a VS Code-style app (no Contents/Resources/app/product.json and bin/); only VS Code and its forks can be disguised"
  [[ ! -f "$(metadata_path "$source" slug)" ]] || die "use the original $KIND_LABEL installation as --source, not a disguise"

  local executable
  executable="$(source_executable "$source")"
  verify_source_app "$source" "$trust_source" "$KIND_TEAM_ID"

  local cli_relative cli_name
  cli_name="$(product_application_name "$source" "$executable")"
  cli_relative="Contents/Resources/app/bin/$cli_name"
  [[ -n "$extensions_mode" ]] || extensions_mode="shared"

  local slug app existing shortcut plist tmp_app backup_app final_icon profile_path
  local target_root transaction installed=false committed=false
  slug="$(slugify "$name")"
  [[ ${#slug} -le 50 ]] || die "NAME is too long (the normalized name must be 50 characters or fewer)"
  shortcut="$cli_name-$slug"
  existing="$(app_for_slug "$slug" || true)"
  if [[ -n "$existing" ]]; then
    if [[ "$(kind_for_app "$existing")" != "$kind" ]]; then
      die "the name '$name' is already used by a $(label_for_app "$existing") disguise at $existing; choose another name"
    fi
    [[ "$force" == "true" ]] || die "disguise '$name' already exists at $existing (use --force to rebuild it)"
    assert_stopped "$existing"
    [[ "$source" != "$existing" ]] || die "source must be the original app, not this disguise"
    [[ "$(shortcut_for_app "$existing" "$slug")" == "$shortcut" ]] || assert_shortcut_owned "$slug" "$(shortcut_for_app "$existing" "$slug")"
  fi
  assert_shortcut_owned "$slug" "$shortcut"

  # Disguises stay in the folder they were created in; new ones go to APP_ROOT.
  mkdir -p "$APP_ROOT" "$DATA_ROOT"
  DATA_ROOT="$(cd "$DATA_ROOT" && pwd -P)"
  if [[ -n "$existing" ]]; then
    target_root="$(cd "$(dirname "$existing")" && pwd -P)"
  else
    target_root="$(cd "$APP_ROOT" && pwd -P)"
  fi
  app="$target_root/$KIND_PREFIX - $name.app"
  profile_path="$(profile_for_app "${existing:-$app}" "$slug")"
  assert_socket_path_fits "$profile_path"
  claim_profile "$profile_path" "$slug"
  lock_slug "$target_root" "$slug"
  transaction="$(mktemp -d "$target_root/.transaction.XXXXXX")"
  tmp_app="$transaction/new.app"
  backup_app=""
  # Runs from the EXIT trap below.
  # shellcheck disable=SC2329
  cleanup_create() {
    local status=$?
    trap - EXIT
    unlock_slug
    if [[ "$committed" != true ]]; then
      if [[ "$installed" == true ]]; then mv "$app" "$transaction/failed.app" || exit 1; fi
      if [[ -n "$backup_app" && -e "$backup_app" ]]; then
        mv "$backup_app" "$existing" || { note "Recovery copy retained at $backup_app"; exit 1; }
      fi
    fi
    rm -rf -- "$transaction"
    exit "$status"
  }
  trap cleanup_create EXIT

  local verb="Creating"
  [[ -z "$existing" ]] || verb="Rebuilding"
  note "$verb '$name' from $(basename "$source")..."
  copy_app_bundle "$source" "$tmp_app"

  plist="$tmp_app/Contents/Info.plist"
  write_launcher "$tmp_app/Contents/MacOS/$LAUNCHER_NAME" "$executable" "$profile_path" "$extensions_mode" "$slug"
  set_keychain_name "$tmp_app" "$(keychain_service_for_slug "$slug")" "$source" "$executable"

  final_icon="$tmp_app/Contents/Resources/$METADATA_PREFIX.icns"
  case "$icon_mode" in
    image) render_to_icns "$icon_value" "$final_icon" ;;
    emoji) render_drawn_icon "$final_icon" emoji "$icon_value" "$(color_hex "$color")" ;;
    built-in) built_in_icon "$color" "$final_icon" ;;
  esac

  /usr/bin/plutil -replace CFBundleExecutable -string "$LAUNCHER_NAME" "$plist"
  /usr/bin/plutil -replace CFBundleIdentifier -string "$BUNDLE_ID_PREFIX.$slug" "$plist"
  # CFBundleName must stay unchanged: Electron derives "Frameworks/<CFBundleName> Helper.app"
  # from it and aborts at launch if the helper cannot be found.
  /usr/bin/plutil -replace CFBundleDisplayName -string "$KIND_PREFIX - $name" "$plist"
  /usr/bin/plutil -replace CFBundleIconFile -string "$METADATA_PREFIX.icns" "$plist"
  # An asset-catalog icon would take precedence over CFBundleIconFile.
  /usr/bin/plutil -remove CFBundleIconName "$plist" >/dev/null 2>&1 || true

  write_metadata "$tmp_app" slug "$slug"
  write_metadata "$tmp_app" name "$name"
  write_metadata "$tmp_app" kind "$kind"
  write_metadata "$tmp_app" label "$KIND_LABEL"
  write_metadata "$tmp_app" color "$color"
  write_metadata "$tmp_app" extensions "$extensions_mode"
  write_metadata "$tmp_app" source "$source"
  write_metadata "$tmp_app" trust-source "$trust_source"
  write_metadata "$tmp_app" executable "$executable"
  write_metadata "$tmp_app" icon-kind "$icon_mode"
  [[ "$icon_mode" != emoji ]] || write_metadata "$tmp_app" emoji "$icon_value"
  write_metadata "$tmp_app" profile "$profile_path"
  write_metadata "$tmp_app" shortcut "$shortcut"
  write_metadata "$tmp_app" cli "$cli_relative"

  sign_disguise "$tmp_app" "$slug" "$executable" "$transaction"

  if [[ -n "$existing" && -e "$existing" ]]; then
    assert_stopped "$existing"
    backup_app="$transaction/previous.app"
    mv "$existing" "$backup_app"
  fi
  if [[ -e "$app" && "$app" != "$existing" ]]; then
    die "an app named '$app' already exists"
  fi
  # Settings are applied before the new bundle is committed, so a disguise is never installed
  # without update.mode pinned: a settings file that cannot be edited fails the whole create
  # and the previous app comes back. A brand-new disguise must not inherit a pin left in a
  # kept profile, and starts tinted.
  [[ -n "$folder_action" || -n "$existing" ]] || folder_action=clear
  [[ -n "$window_tint" || -n "$existing" ]] || window_tint=on
  local tint_state tint_op=keep title_op=clear
  tint_state="${window_tint:-$(read_profile_setting "$profile_path" window-tint off)}"
  if [[ "$tint_state" == on ]]; then
    tint_op="set"
  elif [[ "$window_tint" == off ]]; then
    # Only an explicit "off" removes colors: the user may have set their own.
    tint_op="clear"
  fi
  [[ "$icon_mode" != emoji ]] || title_op="set"
  apply_window_settings "$tmp_app" "$profile_path" "$tint_op" "$color" "$title_op" "$icon_value" set ||
    die "the disguise was not installed: $LAST_SETTINGS_ERROR (fix or move aside that file)"
  apply_pinned_folder "$profile_path" "$folder_action" "$folder"
  [[ -z "$window_tint" ]] || write_profile_setting "$profile_path" window-tint "$window_tint"

  mv "$tmp_app" "$app"
  installed=true
  # mv into an existing folder would have nested the bundle instead of failing.
  [[ -f "$app/Contents/Info.plist" && ! -e "$app/new.app" ]] || die "the app at '$app' changed while it was being built"
  # The new shortcut goes in before the old one goes away, so a failure here leaves the
  # previous disguise with its command.
  write_shortcut "$slug" "$app"
  committed=true
  if [[ -n "$backup_app" && "$(shortcut_for_app "$backup_app" "$slug")" != "$shortcut" ]]; then
    # The shortcut prefix changed (for example code-NAME became codium-NAME); drop the old one.
    rm -f -- "$BIN_ROOT/$(shortcut_for_app "$backup_app" "$slug")"
  fi

  if [[ -n "$existing" ]]; then
    note "Rebuilt: $app"
  else
    note "Created: $app"
  fi
  note "Open it from Finder/Dock, or run: $shortcut"
  if [[ ":$PATH:" != *":$BIN_ROOT:"* ]]; then
    note "Tip: add $BIN_ROOT to PATH to use the $shortcut shortcut."
  fi
)

update_instance() {
  require_macos
  local name="${1:-}"
  [[ -n "$name" ]] || die "update requires a NAME"
  shift

  local color="" icon_mode="" icon_value="" folder_action="" folder="" window_tint="" consumed
  while [[ $# -gt 0 ]]; do
    parse_disguise_option "$@" || die "unknown update option: $1"
    shift "$consumed"
  done
  [[ -n "$color$icon_mode$folder_action$window_tint" ]] || die "nothing to update (see 'code-o-ween help')"
  validate_disguise_options

  local app current_color kind profile display_name rebuild=false
  app="$(require_instance "$name")"
  current_color="$(read_metadata "$app" color "$DEFAULT_COLOR")"
  kind="$(read_metadata "$app" icon-kind image)"
  profile="$(profile_for_app "$app" "$(read_metadata "$app" slug)")"
  display_name="$(name_for_app "$app")"
  # The recorded profile path is data from the bundle; the same guards as create apply before
  # anything is written there, on both the rebuild and the direct path.
  # claim_profile runs the same guards and recreates a missing folder with its marker; a
  # recreated VS Code profile also gets update.mode pinned again (a no-op otherwise).
  claim_profile "$profile" "$(read_metadata "$app" slug)"
  apply_window_settings "$app" "$profile" keep "" keep "" set || die "nothing was changed: $LAST_SETTINGS_ERROR"
  [[ -n "$color" ]] || color="$current_color"

  [[ -z "$icon_mode" && "$color" == "$current_color" ]] || rebuild=true

  if [[ "$rebuild" == true ]]; then
    assert_stopped "$app"
    if [[ -z "$icon_mode" && "$color" != "$current_color" && "$kind" != emoji && "$kind" != built-in ]]; then
      note "Note: this disguise uses a custom image icon, so the color does not change its icon."
    fi
    local -a extra_args=()
    case "$folder_action" in
      set) extra_args+=(--folder "$folder") ;;
      clear) extra_args+=(--no-folder) ;;
    esac
    [[ -z "$window_tint" ]] || extra_args+=(--window-color "$window_tint")
    rebuild_instance "$app" "$color" "${icon_mode:-keep}" "$icon_value" "" ${extra_args[@]+"${extra_args[@]}"}
    return
  fi

  # The settings edit is the step that can fail, so it goes first; the folder changes only once
  # it has succeeded, and nothing is half-applied when the command reports failure.
  if [[ -n "$window_tint" ]]; then
    if [[ "$window_tint" == on ]]; then
      apply_window_settings "$app" "$profile" set "$color" keep "" || die "nothing was changed: $LAST_SETTINGS_ERROR"
    else
      apply_window_settings "$app" "$profile" clear "" keep "" || die "nothing was changed: $LAST_SETTINGS_ERROR"
    fi
    write_profile_setting "$profile" window-tint "$window_tint"
    note "Window color for '$display_name' turned $window_tint."
  fi
  case "$folder_action" in
    set) apply_pinned_folder "$profile" set "$folder"; note "Pinned '$display_name' to $folder (takes effect the next time it is opened)." ;;
    clear) apply_pinned_folder "$profile" clear; note "Removed the pinned folder from '$display_name'." ;;
  esac
}

list_instances() {
  printf '%-18s %-24s %-8s %-10s %s\n' "NAME" "APP" "COLOR" "EXTENSIONS" "PATH"
  local app name color mode folder found="false"
  while IFS= read -r -d '' app; do
    found="true"
    name="$(name_for_app "$app")"
    color="$(read_metadata "$app" color "$DEFAULT_COLOR")"
    mode="$(read_metadata "$app" extensions shared)"
    printf '%-18s %-24s %-8s %-10s %s\n' "$name" "$(label_for_app "$app")" "$color" "$mode" "$app"
    folder="$(read_profile_setting "$(profile_for_app "$app" "$(read_metadata "$app" slug)")" pinned-folder)"
    [[ -z "$folder" ]] || printf '%-18s %-24s %-8s %-10s %s\n' "" "" "" "" "↳ $folder"
  done < <(find_instances)
  [[ "$found" == "true" ]] || note "(no disguises yet)"
}

# Lists the recipes. --porcelain prints tab-separated: id, label, found (yes/no), source path,
# status.
list_kinds() {
  local porcelain="false" kind
  [[ "${1:-}" != "--porcelain" ]] || porcelain="true"
  [[ "$porcelain" == "true" ]] || printf '%-16s %-30s %-17s %s\n' "APP" "NAME" "STATUS" "FOUND AT"
  for kind in $ALL_KINDS; do
    (
      local source found="no"
      load_kind "$kind"
      # die exits the substitution's subshell, so the fallback has to live outside it.
      if source="$(default_source_app 2>/dev/null)"; then found="yes"; else source=""; fi
      if [[ "$porcelain" == "true" ]]; then
        printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$KIND_LABEL" "$found" "$source" "$KIND_STATUS"
      elif [[ "$kind" == other ]]; then
        printf '%-16s %-30s %-17s %s\n' "$kind" "$KIND_LABEL" "$(status_description "$KIND_STATUS")" "(pass --source)"
      else
        printf '%-16s %-30s %-17s %s\n' "$kind" "$KIND_LABEL" "$(status_description "$KIND_STATUS")" "${source:--}"
      fi
    )
  done
}

open_instance() {
  require_macos
  local name="${1:-}"
  [[ -n "$name" ]] || die "open requires a NAME"
  shift || true
  [[ "${1:-}" != "--" ]] || shift
  local slug app
  slug="$(slugify "$name")"
  app="$(require_instance "$name")"
  if [[ $# -eq 0 ]]; then
    # The launcher opens the pinned folder only when the disguise starts. A disguise whose
    # last window was closed is still running, and activating it would only show an empty
    # window, so the folder is handed over as a document, which reaches a running copy too.
    local pinned_folder
    pinned_folder="$(read_profile_setting "$(profile_for_app "$app" "$slug")" pinned-folder)"
    if [[ -n "$pinned_folder" && -d "$pinned_folder" ]]; then
      /usr/bin/open -a "$app" "$pinned_folder"
    else
      /usr/bin/open "$app"
    fi
    return
  fi
  write_shortcut "$slug" "$app"
  "$BIN_ROOT/$(shortcut_for_app "$app" "$slug")" "$@"
}

# Rebuilds a disguise through create_instance, carrying over everything that is not being
# changed. ICON_MODE of "keep" reproduces an emoji or built-in icon from the recorded metadata
# so that a recolor recolors it; a custom image is copied out and back in.
rebuild_instance() {
  local app="$1" color="$2" icon_mode="$3" icon_value="$4" source="$5" kept_icon=""
  shift 5
  [[ -n "$color" ]] || color="$(read_metadata "$app" color "$DEFAULT_COLOR")"
  [[ -n "$source" ]] || source="$(read_metadata "$app" source)"
  if [[ "$icon_mode" == keep ]]; then
    icon_mode="$(read_metadata "$app" icon-kind image)"
    icon_value="$(read_metadata "$app" emoji "")"
    if [[ "$icon_mode" != emoji && "$icon_mode" != built-in || ( "$icon_mode" == emoji && -z "$icon_value" ) ]]; then
      # Custom images, and disguises from before icon kinds were recorded, keep their ICNS.
      icon_mode=image
      kept_icon="$(mktemp -d "${TMPDIR:-/tmp}/code-o-ween-icon.XXXXXX")"
      # Expanded now on purpose: the path is shell-quoted into the trap, so it survives any
      # later change to the variable.
      # shellcheck disable=SC2064
      trap "rm -rf -- $(printf '%q' "$kept_icon")" EXIT
      icon_value="$kept_icon/current.icns"
      cp "$(metadata_path "$app" icns)" "$icon_value"
    fi
  fi

  local -a args=(--app "$(kind_for_app "$app")" --color "$color" --source "$source" --force)
  args+=(--extensions "$(read_metadata "$app" extensions shared)")
  # Trust was given for the recorded source; a different --source gets normal verification.
  if [[ "$(read_metadata "$app" trust-source false)" == true && "$source" == "$(read_metadata "$app" source)" ]]; then
    args+=(--trust-source)
  fi
  case "$icon_mode" in
    emoji) args+=(--emoji "$icon_value") ;;
    image) args+=(--icon "$icon_value") ;;
    built-in) args+=(--built-in-icon) ;;
  esac
  # Not called from a condition: that would disable errexit inside create_instance.
  create_instance "$(name_for_app "$app")" "${args[@]}" "$@"
  if [[ -n "$kept_icon" ]]; then
    rm -rf -- "$kept_icon"
    trap - EXIT
  fi
}

refresh_one() {
  local name="$1" source_override="${2:-}" trust="${3:-false}" app
  local -a trust_args=()
  [[ "$trust" != true ]] || trust_args=(--trust-source)
  app="$(require_instance "$name")"
  if [[ -n "$source_override" ]]; then
    [[ -d "$source_override" ]] || die "not a macOS app bundle: $source_override"
    source_override="$(cd "$source_override" && pwd -P)"
  fi
  assert_stopped "$app"
  [[ -n "$source_override" || -n "$(read_metadata "$app" source)" ]] ||
    die "disguise '$(name_for_app "$app")' does not record its source app; pass --source"
  rebuild_instance "$app" "" keep "" "$source_override" ${trust_args[@]+"${trust_args[@]}"}
}

refresh_instances() {
  require_macos
  local target="${1:-}" source="" trust=false
  [[ -n "$target" ]] || die "refresh requires a NAME or --all"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source) [[ $# -ge 2 ]] || die "--source needs an app path"; source="$2"; shift 2 ;;
      # Fresh consent for a new source (stored trust applies only to the recorded one).
      --trust-source) trust=true; shift ;;
      *) die "unknown refresh option: $1" ;;
    esac
  done
  if [[ "$target" != "--all" ]]; then
    refresh_one "$target" "$source" "$trust"
    return
  fi
  [[ "$trust" != true ]] || die "--trust-source applies to a single disguise; refresh it by NAME"

  local app slug
  local -a slugs=() failed=() source_args=()
  while IFS= read -r -d '' app; do
    slug="$(read_metadata "$app" slug)"
    if is_slug "$slug"; then slugs+=("$slug"); else warn "skipping $app: its recorded name '$slug' is not valid"; fi
  done < <(find_instances)
  [[ ${#slugs[@]} -gt 0 ]] || die "there are no disguises to refresh"
  # Disguises may come from different apps, so one --source cannot apply to all of them.
  [[ -z "$source" || ${#slugs[@]} -eq 1 ]] || die "--source applies to a single disguise; refresh it by NAME"
  [[ -z "$source" ]] || source_args=(--source "$source")
  # Each disguise refreshes in its own process: one failure must not stop the others, and
  # calling the rebuild from a condition here would disable errexit inside it, so a disguise
  # that failed to rebuild would be reported as refreshed.
  for slug in "${slugs[@]}"; do
    "$0" refresh "$slug" ${source_args[@]+"${source_args[@]}"} || failed+=("$slug")
  done
  [[ ${#failed[@]} -eq 0 ]] || die "could not refresh: ${failed[*]}"
}

remove_instance() {
  require_macos
  local name="${1:-}"
  [[ -n "$name" ]] || die "remove requires a NAME"
  shift || true
  local delete_data="false" yes="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delete-data) delete_data="true"; shift ;;
      --yes) yes="true"; shift ;;
      *) die "unknown remove option: $1" ;;
    esac
  done
  local slug app answer profile shortcut
  slug="$(slugify "$name")"
  app="$(require_instance "$name")"
  shortcut="$(shortcut_for_app "$app" "$slug")"
  lock_slug "$(dirname "$app")" "$slug"
  trap unlock_slug EXIT
  assert_stopped "$app"
  assert_shortcut_owned "$slug" "$shortcut"
  profile="$(profile_for_app "$app" "$slug")"
  # Checked before the prompt and before anything is deleted, so a settings folder we do not
  # own cannot cost the user their app bundle on the way to the refusal.
  [[ "$delete_data" != "true" ]] || assert_profile_ours "$profile" "$slug" delete
  if [[ "$yes" != "true" ]]; then
    if [[ "$delete_data" == true ]]; then
      printf "Remove '%s' AND permanently delete its settings at '%s' and its Keychain item? [y/N] " "$(name_for_app "$app")" "$profile"
    else
      printf "Remove '%s'? Its settings will be kept. [y/N] " "$(name_for_app "$app")"
    fi
    read -r answer || answer=""
    [[ "$answer" == "y" || "$answer" == "Y" ]] || { note "Cancelled."; return; }
  fi
  # Rechecked after the prompt: the confirmation window can be long.
  assert_stopped "$app"
  assert_shortcut_owned "$slug" "$shortcut"
  [[ "$delete_data" != "true" ]] || assert_profile_ours "$profile" "$slug" delete
  rm -rf -- "$app"
  rm -f -- "$BIN_ROOT/$shortcut"
  if [[ "$delete_data" == "true" ]]; then
    rm -rf -- "$profile"
    delete_keychain_item "$slug"
    note "Removed the app and its settings."
  else
    note "Removed the app. Settings remain at: $profile"
  fi
}

doctor() {
  local has_errors="false" kind found="false"
  if [[ "$(uname -s)" == "Darwin" ]]; then note "OK  macOS"; else note "ERR macOS is required"; has_errors="true"; fi
  for kind in $ALL_KINDS; do
    [[ "$kind" != other ]] || continue
    if (load_kind "$kind"
        source="$(default_source_app 2>/dev/null)" || exit 1
        if (verify_source_app "$source" false "$KIND_TEAM_ID") >/dev/null 2>&1; then
          note "OK  $KIND_LABEL: $source"
        else
          note "WARN $KIND_LABEL: $source (not signed as expected; needs --trust-source)"
        fi); then
      found="true"
    fi
  done
  if [[ "$found" == "false" ]]; then note "ERR none of the supported apps were found (run 'code-o-ween apps')"; has_errors="true"; fi
  if [[ -d "$ICON_DIR" ]]; then note "OK  icons: $ICON_DIR"; else note "ERR icons missing: $ICON_DIR"; has_errors="true"; fi
  if command -v codesign >/dev/null; then note "OK  codesign"; else note "ERR codesign is unavailable"; has_errors="true"; fi
  if [[ -x /usr/bin/osascript && -x /usr/bin/iconutil && -x /usr/bin/sips ]]; then note "OK  custom icon tools"; else note "ERR custom icon tools are unavailable"; has_errors="true"; fi
  if [[ ":$PATH:" == *":$BIN_ROOT:"* ]]; then note "OK  $BIN_ROOT is on PATH"; else note "WARN add $BIN_ROOT to PATH for the terminal shortcuts"; fi
  [[ "$has_errors" == "false" ]]
}

open_manager() {
  require_macos
  local manager="${CODE_O_WEEN_MANAGER_APP:-$HOME/Applications/Code-o-ween.app}"
  [[ -d "$manager" ]] || die "manager UI is not installed; run build-ui.sh from the package"
  /usr/bin/open "$manager"
}

# The test scripts source this file to call its functions directly, so dispatch only when it
# is run as a program.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

command="${1:-help}"
shift || true
case "$command" in
  create) create_instance "$@" ;;
  update) update_instance "$@" ;;
  open) open_instance "$@" ;;
  list) list_instances ;;
  apps) list_kinds "$@" ;;
  colors) color_names ;;
  refresh) refresh_instances "$@" ;;
  remove) remove_instance "$@" ;;
  gui) open_manager ;;
  doctor) doctor ;;
  version|--version|-v) printf 'Code-o-ween %s\n' "$VERSION" ;;
  help|--help|-h) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
