#!/bin/bash

set -euo pipefail

# A CDPATH in the environment would make `cd` resolve relative paths against other folders.
unset CDPATH

VERSION="0.1.0"

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  while [[ -L "$source_path" ]]; do
    local source_dir
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
  done
  cd -P "$(dirname "$source_path")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
ICON_DIR="${CODE_O_WEEN_ICON_DIR:-$SCRIPT_DIR/icons}"
APP_ROOT="${CODE_O_WEEN_APP_ROOT:-$HOME/Applications/Code-o-ween}"
# VS Code places its IPC socket inside --user-data-dir and macOS limits socket paths to
# 103 bytes, so the default data root is kept short.
DATA_ROOT="${CODE_O_WEEN_DATA_ROOT:-$HOME/.code-o-ween}"
MAX_SOCKET_PATH=103
BIN_ROOT="${CODE_O_WEEN_BIN_ROOT:-$HOME/.local/bin}"
LAUNCHER_NAME="code-o-ween-launcher"
BUNDLE_ID_PREFIX="local.code-o-ween"
# Metadata files inside a disguise: Contents/Resources/<prefix>.<key>.
METADATA_PREFIX="code-o-ween"
DEFAULT_COLOR="blue"
ALL_KINDS="vscode vscode-insiders vscodium other"
# A settings folder Code-o-ween created carries this marker naming the disguise that owns it.
# Only a marked folder may be used or deleted.
PROFILE_MARKER=".code-o-ween-profile"
# Microsoft's Team ID, pinned for Visual Studio Code. A recipe with no pinned team accepts any
# Developer ID signature (see verify_source_app).
MICROSOFT_TEAM_ID="UBF8T346G9"
# Darkest first, which is the order the manager's swatches show. Every preset is dark enough
# for white text (a contrast of at least 4.5:1, see foregroundFor in apply_window_settings).
# blue, green, orange, pink, purple, red, teal and yellow have hand-made bundled icons for
# VS Code-style apps; the rest, and any #RRGGBB color, get a drawn badge.
COLOR_TABLE=(
  black:#212121 navy:#1A237E magenta:#AD1457 indigo:#3F51B5 brown:#795548 slate:#546E7A purple:#7E57C2 lime:#4F7D2A
  yellow:#946A00 orange:#BF4F00 green:#1E8255 teal:#007F88 red:#D13C3C blue:#2276D2 pink:#D33682
)

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

warn() {
  printf 'Warning: %s\n' "$*" >&2
}

# Runs a command, showing its output only if it fails. Keeps codesign quiet on success
# without hiding the reason for a failure.
run_quiet() {
  local output
  output="$("$@" 2>&1)" || { printf '%s\n' "$output" >&2; return 1; }
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

validate_name() {
  local name="$1" control='[[:cntrl:]]'
  [[ -n "$name" ]] || die "NAME cannot be empty"
  # A leading dash would be read as an option by the CLI and by the manager UI.
  [[ "$name" != -* ]] || die "NAME cannot start with '-'"
  [[ "$name" != *"/"* && "$name" != *":"* ]] || die "NAME cannot contain '/' or ':'"
  [[ ! "$name" =~ $control ]] || die "NAME cannot contain control characters"
  [[ "$name" != [[:space:]]* && "$name" != *[[:space:]] ]] || die "NAME cannot start or end with spaces"
}

usage() {
  cat <<'EOF'
Code-o-ween — disguise VS Code for trick or treat.

Usage:
  code-o-ween create NAME [--app APP | --source APP_BUNDLE [--trust-source]] [--color COLOR]
                          [--emoji EMOJI | --icon FILE | --built-in-icon]
                          [--folder DIR] [--window-color on|off]
                          [--extensions shared|isolated] [--force]
  code-o-ween update NAME [--color COLOR] [--emoji EMOJI | --icon FILE | --built-in-icon]
                          [--folder DIR | --no-folder] [--window-color on|off]
  code-o-ween open NAME [-- PATH ...]
  code-o-ween list
  code-o-ween apps
  code-o-ween colors
  code-o-ween refresh NAME [--source APP_BUNDLE [--trust-source]]
  code-o-ween refresh --all
  code-o-ween remove NAME [--delete-data] [--yes]
  code-o-ween gui
  code-o-ween doctor
  code-o-ween version

Examples:
  code-o-ween create Cauldron --color orange --emoji "🎃" --extensions isolated
  code-o-ween create Nightly --app vscode-insiders --color purple --emoji "👻"
  code-o-ween create Work --icon ~/Pictures/vampire-code.svg
  code-o-ween create Night --color "#1A1A2E" --emoji "🦇"
  code-o-ween create Cauldron --emoji "🎃" --folder ~/code/cauldron
  code-o-ween update Cauldron --color purple
  code-o-ween create Beta --source "/Applications/Some VS Code Fork.app"
  code-o-ween open Cauldron -- ~/code/cauldron
  code-cauldron ~/code/cauldron

APP is one of the recipes listed by 'code-o-ween apps' (default: vscode). With --source
alone, the app is recognized from its bundle identifier; any other VS Code-style app (a fork
that ships Resources/app/product.json and its bin/ launcher) is accepted under its own name.

COLOR is a preset name from 'code-o-ween colors' or any #RRGGBB value.

A source app must be signed by its publisher (for recipes with a pinned Team ID) or by an
identified developer. --trust-source accepts any validly signed build, for example VSCodium.

Environment overrides:
  CODE_O_WEEN_<APP>_APP    Source bundle for a recipe, e.g. CODE_O_WEEN_CHROME_APP
  VSCODE_APP               Source Visual Studio Code.app (same as CODE_O_WEEN_VSCODE_APP)
  CODE_O_WEEN_APP_ROOT     Where disguise apps are stored
  CODE_O_WEEN_DATA_ROOT    Where settings and isolated extensions are stored (keep it short)
  CODE_O_WEEN_BIN_ROOT     Where terminal shortcuts are created
EOF
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "this utility only runs on macOS"
}

# The shape slugify produces. Anything read back from a bundle that does not match is not used
# as a command argument: a metadata file saying "--all" must not turn "refresh <slug>" into a
# refresh of everything.
is_slug() {
  local pattern='^[a-z0-9]+(-[a-z0-9]+)*$'
  [[ "$1" =~ $pattern ]]
}

slugify() {
  local value="$1"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
  value="$(printf '%s' "$value" | tr -cd 'a-z0-9._-')"
  value="$(printf '%s' "$value" | sed -E 's/[-_.]+/-/g; s/^-//; s/-$//')"
  [[ -n "$value" ]] || die "NAME must contain at least one ASCII letter or number"
  printf '%s' "$value"
}

# ---------------------------------------------------------------------------------------------
# Recipes
#
# Every supported app is a VS Code-style app: a disguise keeps its data apart with
# --user-data-dir (and optionally --extensions-dir), gets a terminal shortcut on the bundled
# command-line launcher, and a Keychain item of its own.
#
# load_kind sets KIND, KIND_LABEL, KIND_PREFIX (the "PREFIX - NAME.app" part), KIND_CANDIDATES
# (the bundle name looked up in /Applications and ~/Applications), KIND_BUNDLE_IDS, KIND_TEAM_ID
# (the publisher's Team ID, when it is pinned), and KIND_STATUS:
#   verified    created, launched and exercised on a Mac
#   unverified  the mechanism is in place, but the app has not been run as a disguise
# Only Visual Studio Code itself is verified; the others share its mechanism but have not
# been run.
# ---------------------------------------------------------------------------------------------
load_kind() {
  KIND="$1"
  KIND_CANDIDATES=""
  KIND_BUNDLE_IDS=""
  KIND_TEAM_ID=""
  KIND_STATUS="unverified"
  case "$KIND" in
    vscode)
      KIND_LABEL="Visual Studio Code"; KIND_PREFIX="VS Code"
      KIND_CANDIDATES="Visual Studio Code.app"; KIND_BUNDLE_IDS="com.microsoft.VSCode"
      KIND_TEAM_ID="$MICROSOFT_TEAM_ID"; KIND_STATUS="verified" ;;
    vscode-insiders)
      KIND_LABEL="Visual Studio Code - Insiders"; KIND_PREFIX="VS Code Insiders"
      KIND_CANDIDATES="Visual Studio Code - Insiders.app"; KIND_BUNDLE_IDS="com.microsoft.VSCodeInsiders" ;;
    vscodium)
      KIND_LABEL="VSCodium"; KIND_PREFIX="VSCodium"
      KIND_CANDIDATES="VSCodium.app"; KIND_BUNDLE_IDS="com.vscodium" ;;
    other)
      # Any VS Code-style app passed with --source: a fork under its own name. Label and
      # prefix come from the bundle itself (see configure_kind_for_source).
      KIND_LABEL="Another VS Code-style app"; KIND_PREFIX="" ;;
    *) die "unknown app '$KIND' (run 'code-o-ween apps')" ;;
  esac
}

status_description() {
  case "$1" in
    verified) printf 'verified' ;;
    unverified) printf 'not yet verified' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Says so once for a recipe that has not been run as a disguise yet.
assert_kind_usable() {
  [[ "$KIND_STATUS" != unverified ]] ||
    warn "$KIND_LABEL has not been run as a disguise on a Mac yet; if it misbehaves, 'code-o-ween remove' takes it away again."
}

# Name of the environment variable that overrides a recipe's source bundle.
source_env_name() {
  printf 'CODE_O_WEEN_%s_APP' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
}

# Prints the source bundle for the loaded recipe.
default_source_app() {
  local env_name dir
  env_name="$(source_env_name "$KIND")"
  if [[ -n "${!env_name:-}" ]]; then
    printf '%s' "${!env_name}"
    return
  fi
  if [[ "$KIND" == vscode && -n "${VSCODE_APP:-}" ]]; then
    printf '%s' "$VSCODE_APP"
    return
  fi
  [[ -n "$KIND_CANDIDATES" ]] || die "'$KIND_LABEL' has no default location; pass --source /path/to/App.app"
  for dir in /Applications "$HOME/Applications"; do
    if [[ -d "$dir/$KIND_CANDIDATES" ]]; then
      printf '%s' "$dir/$KIND_CANDIDATES"
      return
    fi
  done
  die "$KIND_CANDIDATES was not found; pass --source /path/to/$KIND_CANDIDATES"
}

# Prints the recipe whose bundle identifier list contains ID, if any.
kind_for_bundle_id() {
  local id="$1" kind
  [[ -n "$id" ]] || return 1
  for kind in $ALL_KINDS; do
    if (load_kind "$kind"; [[ " $KIND_BUNDLE_IDS " == *" $id "* ]]); then
      printf '%s' "$kind"
      return 0
    fi
  done
  return 1
}

plist_value() {
  /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null || true
}

is_vscode_style_app() {
  [[ -f "$1/Contents/Resources/app/product.json" && -d "$1/Contents/Resources/app/bin" ]]
}

# Prints the recipe for an app bundle: a known bundle identifier, else other.
detect_kind() {
  local kind
  if kind="$(kind_for_bundle_id "$(plist_value "$1" CFBundleIdentifier)")"; then
    printf '%s' "$kind"
  else
    printf 'other'
  fi
}

app_bundle_name() {
  local name
  name="$(basename "$1" .app)"
  [[ -n "$name" && "$name" != "." ]] || die "cannot determine the app name of $1"
  printf '%s' "$name"
}

# Loads a recipe and, for other, takes the names from the bundle itself.
configure_kind_for_source() {
  local kind="$1" source="$2"
  load_kind "$kind"
  if [[ "$KIND" == other ]]; then
    KIND_LABEL="$(app_bundle_name "$source")"
    KIND_PREFIX="$KIND_LABEL"
  fi
}

# Prints the stored form of a color: a preset name, or an upper-case #RRGGBB.
canonical_color() {
  local value="$1" entry hex_pattern='^#[0-9A-Fa-f]{6}$'
  if [[ "$value" =~ $hex_pattern ]]; then
    printf '%s' "$value" | tr '[:lower:]' '[:upper:]'
    return 0
  fi
  value="$(lowercase "$value")"
  for entry in "${COLOR_TABLE[@]}"; do
    if [[ "${entry%%:*}" == "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

color_hex() {
  local value="$1" entry
  if [[ "$value" == \#* ]]; then
    printf '%s' "$value" | tr '[:lower:]' '[:upper:]'
    return 0
  fi
  value="$(lowercase "$value")"
  for entry in "${COLOR_TABLE[@]}"; do
    if [[ "${entry%%:*}" == "$value" ]]; then
      printf '%s' "${entry#*:}"
      return 0
    fi
  done
  return 1
}

color_names() {
  local entry
  for entry in "${COLOR_TABLE[@]}"; do printf '%-8s %s\n' "${entry%%:*}" "${entry#*:}"; done
}

# Renders a transparent 1024x1024 PNG with AppKit via JavaScript for Automation, which ships
# with macOS. Usage: render_png emoji EMOJI HEX OUTPUT | render_png code HEX OUTPUT |
# render_png image FILE OUTPUT.
render_png() {
  /usr/bin/osascript -l JavaScript - "$@" >/dev/null 2>&1 <<'JXA'
ObjC.import('AppKit');
function run(argv) {
  const mode = argv[0], out = argv[argv.length - 1], size = 1024;
  const rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
    null, size, size, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0);
  $.NSGraphicsContext.saveGraphicsState;
  $.NSGraphicsContext.setCurrentContext($.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep));
  // Paints the rounded, colored tile and returns the text color that reads best on it.
  const paintTile = (hexArg) => {
    const hex = hexArg.replace('#', '');
    const channel = (i) => parseInt(hex.substr(i, 2), 16) / 255;
    $.NSColor.colorWithSRGBRedGreenBlueAlpha(channel(0), channel(2), channel(4), 1).setFill;
    $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius($.NSMakeRect(48, 48, 928, 928), 210, 210).fill;
    const ring = $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius($.NSMakeRect(70, 70, 884, 884), 190, 190);
    ring.lineWidth = 7;
    $.NSColor.colorWithSRGBRedGreenBlueAlpha(1, 1, 1, 0.35).setStroke;
    ring.stroke;
    const light = 0.299 * channel(0) + 0.587 * channel(2) + 0.114 * channel(4) > 0.62;
    return light ? $.NSColor.colorWithSRGBRedGreenBlueAlpha(0.12, 0.12, 0.12, 1) : $.NSColor.whiteColor;
  };
  const drawCentered = (string, font, color) => {
    const attributes = $.NSMutableDictionary.dictionary;
    attributes.setObjectForKey(font, $.NSFontAttributeName);
    attributes.setObjectForKey(color, $.NSForegroundColorAttributeName);
    const text = $(string);
    const bounds = text.sizeWithAttributes(attributes);
    text.drawAtPointWithAttributes($.NSMakePoint((size - bounds.width) / 2, (size - bounds.height) / 2), attributes);
  };
  const drawImage = (file) => {
    const image = $.NSImage.alloc.initWithContentsOfFile(file);
    if (image.isNil() || image.size.width <= 0 || image.size.height <= 0) throw new Error('unreadable image');
    const scale = Math.min(size / image.size.width, size / image.size.height);
    const w = image.size.width * scale, h = image.size.height * scale;
    image.drawInRectFromRectOperationFraction($.NSMakeRect((size - w) / 2, (size - h) / 2, w, h), $.NSZeroRect, $.NSCompositingOperationSourceOver, 1);
  };
  if (mode === 'emoji') {
    const foreground = paintTile(argv[2]);
    drawCentered(argv[1], $.NSFont.fontWithNameSize('Apple Color Emoji', 560), foreground);
  } else if (mode === 'code') {
    const foreground = paintTile(argv[1]);
    drawCentered('</>', $.NSFont.monospacedSystemFontOfSizeWeight(360, $.NSFontWeightBold), foreground);
  } else {
    drawImage(argv[1]);
  }
  $.NSGraphicsContext.restoreGraphicsState;
  const png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $({}));
  if (!png.writeToFileAtomically(out, true)) throw new Error('could not write ' + out);
}
JXA
}

png_to_icns() {
  local source_png="$1" output="$2" iconset="$3/AppIcon.iconset" size filename
  mkdir -p "$iconset"
  while read -r size filename; do
    /usr/bin/sips -s format png -z "$size" "$size" "$source_png" --out "$iconset/$filename" >/dev/null
  done <<'EOF'
16 icon_16x16.png
32 icon_16x16@2x.png
32 icon_32x32.png
64 icon_32x32@2x.png
128 icon_128x128.png
256 icon_128x128@2x.png
256 icon_256x256.png
512 icon_256x256@2x.png
512 icon_512x512.png
1024 icon_512x512@2x.png
EOF
  /usr/bin/iconutil -c icns "$iconset" -o "$output"
}

render_to_icns() {
  local input="$1" output="$2" extension tmp_root source_png preview
  extension="${input##*.}"
  extension="$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')"

  case "$extension" in
    icns) cp "$input" "$output"; return ;;
    svg|png|jpg|jpeg|tif|tiff|webp) ;;
    *) die "unsupported icon format '.$extension'; use SVG, PNG, JPEG, TIFF, WebP, or ICNS" ;;
  esac

  tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/code-o-ween-icon.XXXXXX")"
  source_png="$tmp_root/source.png"
  if ! render_png image "$input" "$source_png"; then
    if [[ "$extension" == "svg" ]]; then
      # Fallback: Quick Look thumbnails have an opaque background.
      mkdir -p "$tmp_root/render"
      /usr/bin/qlmanage -t -s 1024 -o "$tmp_root/render" "$input" >/dev/null 2>&1 || true
      preview="$(find "$tmp_root/render" -maxdepth 1 -type f -name '*.png' -print -quit)"
      if [[ -z "$preview" ]]; then
        rm -rf -- "$tmp_root"
        die "macOS could not render the SVG: $input"
      fi
      source_png="$preview"
    else
      source_png="$input"
    fi
  fi

  png_to_icns "$source_png" "$output" "$tmp_root"
  rm -rf -- "$tmp_root"
}

# Draws an icon with render_png and packs it into OUTPUT. Usage: render_drawn_icon OUTPUT MODE ARGS...
render_drawn_icon() {
  local output="$1" tmp_root
  shift
  tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/code-o-ween-icon.XXXXXX")"
  render_png "$@" "$tmp_root/icon.png" || { rm -rf -- "$tmp_root"; die "macOS could not draw the $1 icon"; }
  png_to_icns "$tmp_root/icon.png" "$output" "$tmp_root"
  rm -rf -- "$tmp_root"
}

# The icon a disguise gets when no emoji or image was chosen: the hand-made bundled icon for
# the color, or the drawn </> badge for colors without one.
built_in_icon() {
  local color="$1" output="$2"
  if [[ -f "$ICON_DIR/$color.icns" ]]; then
    cp "$ICON_DIR/$color.icns" "$output"
  else
    render_drawn_icon "$output" code "$(color_hex "$color")"
  fi
}

# ---------------------------------------------------------------------------------------------
# Source verification and signing
# ---------------------------------------------------------------------------------------------

# Prints the source bundle's executable name, rejecting anything that is not a plain name.
# The name is used to build paths and is run as Node, so it is validated before use.
source_executable() {
  local app="$1" executable pattern='^[A-Za-z0-9 ._-]+$'
  executable="$(plist_value "$app" CFBundleExecutable)"
  [[ "$executable" != "$LAUNCHER_NAME" ]] || die "use the original app installation as --source, not a disguise"
  [[ -n "$executable" && "$executable" =~ $pattern && "$executable" != .* ]] ||
    die "unexpected executable name in $app: $executable"
  [[ -f "$app/Contents/MacOS/$executable" && -x "$app/Contents/MacOS/$executable" ]] ||
    die "could not locate the executable of $app"
  printf '%s' "$executable"
}

# The source bundle is cloned, its executable is run as Node, and the copy is given a fresh
# signature, so it has to be verified first. A recipe with a pinned Team ID must come from that
# publisher; the others accept any Apple-anchored signature, which still rejects unsigned and
# tampered bundles. --trust-source relaxes this to "the signature verifies".
verify_source_app() {
  local source="$1" trust="$2" team="$3" problem
  local -a requirement=()
  if [[ "$trust" == true ]]; then
    problem="the source app's code signature is not valid"
  elif [[ -n "$team" ]]; then
    requirement=(-R="anchor apple generic and certificate leaf[subject.OU] = \"$team\"")
    problem="the source app is not ${KIND_LABEL:-the expected app} signed by its publisher (pass --trust-source to use another validly signed build)"
  else
    requirement=(-R="anchor apple generic")
    problem="the source app is not signed by an identified developer (pass --trust-source to use it anyway)"
  fi
  run_quiet /usr/bin/codesign --verify --deep --strict ${requirement[@]+"${requirement[@]}"} "$source" ||
    die "$problem: $source"
}

# Adds the disable-library-validation entitlement to CODE and re-signs it ad hoc under the
# hardened runtime. Once re-signed, a disguise's executables no longer share the publisher's
# Team ID with the frameworks they load, and dyld refuses the mapping ("different Team IDs")
# without that entitlement.
#
# --options runtime is unconditional and must stay that way: the hardened runtime on the
# executable the kernel actually starts is what makes macOS ignore DYLD_* variables, and the
# preceding --deep pass has already cleared the flags that could be read back from the copy.
sign_without_library_validation() {
  local code="$1" work="$2" entitlements
  shift 2
  entitlements="$(mktemp "$work/entitlements.XXXXXX")"
  /usr/bin/codesign -d --entitlements - --xml "$code" >"$entitlements" 2>/dev/null || true
  if [[ ! -s "$entitlements" ]]; then
    printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict/></plist>\n' >"$entitlements"
  fi
  /usr/libexec/PlistBuddy -c 'Delete :com.apple.security.cs.disable-library-validation' "$entitlements" >/dev/null 2>&1 || true
  /usr/libexec/PlistBuddy -c 'Add :com.apple.security.cs.disable-library-validation bool true' "$entitlements" >/dev/null
  # Preserving the publisher's entitlements must not preserve this one: it makes the hardened
  # runtime honour DYLD_* again, which is exactly what the re-signing is meant to prevent.
  /usr/libexec/PlistBuddy -c 'Delete :com.apple.security.cs.allow-dyld-environment-variables' "$entitlements" >/dev/null 2>&1 || true
  run_quiet /usr/bin/codesign --force --sign - --options runtime \
    --entitlements "$entitlements" "$@" "$code" || die "could not sign $code"
}

# Signs a disguise inside-out, keeping the hardened runtime and entitlements the publisher
# shipped. A plain "codesign --deep --sign -" would drop both, which is what let
# DYLD_INSERT_LIBRARIES work against earlier disguises.
#
# The main executable is signed under its own identifier so that each disguise has a distinct
# code hash and therefore its own Keychain access, instead of one "Always Allow" covering every
# disguise of the same app. The hash stays stable across refreshes of the same app version.
sign_disguise() {
  local app="$1" slug="$2" executable="$3" work="$4" nested
  rm -rf -- "$app/Contents/_CodeSignature"
  run_quiet /usr/bin/codesign --force --deep --sign - --preserve-metadata=entitlements,flags "$app" ||
    die "could not sign the disguise at $app"
  # Helper bundles live in Contents/Frameworks, directly or inside a versioned framework, so
  # they are found rather than globbed.
  #
  # Depth-first, and frameworks are re-sealed in the same pass: signing a helper invalidates
  # the seal of the framework that contains it, and only re-sealing the outer bundle would
  # leave that framework reported as "nested code is modified or invalid".
  while IFS= read -r nested; do
    [[ -d "$nested" ]] || continue
    case "$nested" in
      *.app) sign_without_library_validation "$nested" "$work" ;;
      *.framework)
        run_quiet /usr/bin/codesign --force --sign - --preserve-metadata=entitlements,flags "$nested" ||
          die "could not seal $nested" ;;
    esac
  done < <(find "$app/Contents" \( -name '*.app' -o -name '*.framework' \) -type d -depth 2>/dev/null || true)
  sign_without_library_validation "$app/Contents/MacOS/$executable" "$work" -i "$BUNDLE_ID_PREFIX.$slug.code"
  run_quiet /usr/bin/codesign --force --sign - --preserve-metadata=entitlements,flags "$app" ||
    die "could not seal the disguise at $app"
  # A disguise that does not verify will be refused by Launch Services, so it is better to fail
  # here and let the create transaction roll back than to install a bundle that cannot open.
  run_quiet /usr/bin/codesign --verify --deep --strict "$app" ||
    die "the disguise at $app does not pass signature verification, so macOS would refuse to open it; this app's bundle layout is not supported yet"
}

# ---------------------------------------------------------------------------------------------
# Settings folder ownership
# ---------------------------------------------------------------------------------------------

# Prints PATH with symlinks resolved in its deepest existing ancestor and "." and ".." collapsed
# in the rest, so a folder that does not exist yet still compares by where it would really be
# created. The filesystem cannot resolve the missing part, and left as spelled, "<missing>/.."
# would name the parent while looking like something inside it. The root prints as nothing.
physical_path() {
  local path="${1%/}" rest="" resolved segment
  local -a segments=() kept=()
  while [[ -n "$path" && ! -d "$path" ]]; do
    rest="/${path##*/}$rest"
    path="${path%/*}"
  done
  resolved="$(cd -P "${path:-/}" 2>/dev/null && pwd)" || resolved="$path"
  [[ "$resolved" != / ]] || resolved=""
  IFS=/ read -r -a segments <<<"$resolved$rest"
  for segment in ${segments[@]+"${segments[@]}"}; do
    case "$segment" in
      ""|.) ;;
      ..) [[ ${#kept[@]} -eq 0 ]] || unset "kept[$((${#kept[@]} - 1))]" ;;
      *) kept+=("$segment") ;;
    esac
  done
  [[ ${#kept[@]} -gt 0 ]] || return 0
  printf '/%s' "${kept[@]}"
}

# The home folder and its ancestors are never a settings folder, however the path is spelled:
# both sides are compared by physical location, and case-insensitively because macOS
# filesystems usually are.
assert_safe_profile_location() {
  local profile home
  profile="$(lowercase "$(physical_path "$1")")"
  home="$(lowercase "$(physical_path "$HOME")")"
  [[ -n "$profile" && "$profile" != "$home" && "$home/" != "$profile"/* ]] ||
    die "refusing to use '$1' as a settings folder"
}

# True when PROFILE does not exist or carries our marker for SLUG. A familiar set of entry
# names is not proof of ownership (a project folder can contain a "profile" directory too), so
# an unmarked folder is never adopted.
profile_is_ours() {
  local profile="$1" slug="$2"
  # Only a genuinely absent path is claimable; an existing file or other non-directory is not.
  if [[ ! -e "$profile" && ! -L "$profile" ]]; then return 0; fi
  [[ -d "$profile" && -f "$profile/$PROFILE_MARKER" ]] || return 1
  [[ "$(<"$profile/$PROFILE_MARKER")" == "$slug" ]]
}

# The guards every command runs before it writes into or deletes a settings folder: never the
# home folder, never a symbolic link (rm -rf would remove the link and leave the data, and the
# ownership checks would have looked through it), and only a folder Code-o-ween owns.
assert_profile_ours() {
  local profile="$1" slug="$2" action="$3" hint="${4:-}"
  assert_safe_profile_location "$profile"
  [[ ! -L "$profile" ]] || die "refusing to $action '$profile': it is a symbolic link; point Code-o-ween at the real folder"
  profile_is_ours "$profile" "$slug" ||
    die "refusing to $action '$profile': it was not created by Code-o-ween for '$slug'$hint"
}

claim_profile() {
  local profile="$1" slug="$2"
  assert_profile_ours "$profile" "$slug" use "; move it aside, or choose another NAME or CODE_O_WEEN_DATA_ROOT"
  mkdir -p "$profile"
  printf '%s' "$slug" >"$profile/$PROFILE_MARKER"
}

# ---------------------------------------------------------------------------------------------
# Locating disguises and their metadata
# ---------------------------------------------------------------------------------------------
# Prints the path of every disguise, NUL-separated, in a stable order.
find_instances() {
  local metadata
  [[ -d "$APP_ROOT" ]] || return 0
  while IFS= read -r -d '' metadata; do
    printf '%s\0' "${metadata%/Contents/Resources/*.slug}"
  done < <(find -H "$APP_ROOT" -mindepth 4 -maxdepth 4 -type f -name "$METADATA_PREFIX.slug" -print0 2>/dev/null || true) | sort -z
}

# The metadata file for KEY inside a disguise.
metadata_path() {
  printf '%s' "$1/Contents/Resources/$METADATA_PREFIX.$2"
}

# Prints the contents of FILE, or DEFAULT when it does not exist.
read_file_or_default() {
  if [[ -f "$1" ]]; then printf '%s' "$(<"$1")"; else printf '%s' "${2:-}"; fi
}

read_metadata() {
  read_file_or_default "$(metadata_path "$1" "$2")" "${3:-}"
}

write_metadata() {
  printf '%s' "$3" >"$(metadata_path "$1" "$2")"
}

require_instance() {
  local app
  app="$(app_for_slug "$(slugify "$1")" || true)"
  [[ -n "$app" ]] || die "disguise '$1' does not exist"
  printf '%s' "$app"
}

# Prints the one app carrying SLUG. Two bundles claiming the same slug would make every command
# act on an arbitrary one (remove could delete the wrong app), so that is refused instead.
app_for_slug() {
  local slug="$1" app
  local -a matches=()
  is_slug "$slug" || return 1
  while IFS= read -r -d '' app; do
    [[ "$(read_metadata "$app" slug)" != "$slug" ]] || matches+=("$app")
  done < <(find_instances)
  case ${#matches[@]} in
    0) return 1 ;;
    1) printf '%s' "${matches[0]}" ;;
    *) die "more than one disguise claims the name '$slug': $(printf '%s; ' "${matches[@]}")remove or rename the extra bundles" ;;
  esac
}

name_for_app() {
  local name
  name="$(read_metadata "$1" name)"
  if [[ -n "$name" ]]; then printf '%s' "$name"; else basename "$1" .app; fi
}

kind_for_app() {
  read_metadata "$1" kind vscode
}

label_for_app() {
  read_metadata "$1" label "Visual Studio Code"
}

# The recorded shortcut name; code-NAME when a bundle records none.
shortcut_for_app() {
  read_metadata "$1" shortcut "code-$2"
}

copy_app_bundle() {
  local source="$1" destination="$2"
  if cp -cR "$source" "$destination" 2>/dev/null; then
    return
  fi
  note "APFS clone unavailable; copying the full app bundle..."
  /usr/bin/ditto "$source" "$destination"
}

assert_stopped() {
  local app="$1" resolved processes
  resolved="$(cd -P "$app" 2>/dev/null && pwd)" || resolved="$app"
  processes="$(/bin/ps -axo command=)" || die "cannot inspect running processes"
  if [[ "$processes" == *"$app/Contents/"* || "$processes" == *"$resolved/Contents/"* ]]; then
    die "quit the disguise at '$app' before refreshing or removing it"
  fi
}

assert_shortcut_owned() {
  local slug="$1" shortcut="$BIN_ROOT/$2"
  [[ ! -L "$shortcut" ]] || die "refusing to replace a symlink: $shortcut"
  if [[ -e "$shortcut" ]]; then
    [[ -f "$shortcut" ]] || die "shortcut is not a regular file: $shortcut"
    /usr/bin/grep -Fxq "# Managed by Code-o-ween: $slug" "$shortcut" ||
      die "unrecognized shortcut: $shortcut; move it aside manually before retrying"
  fi
}

profile_for_app() {
  local app="$1" slug="$2" profile
  profile="$(read_metadata "$app" profile)"
  [[ -n "$profile" ]] || profile="$DATA_ROOT/$slug"
  [[ "$profile" == /* && "$profile" == */"$slug" && "$profile" != *'/../'* ]] || die "unsafe profile path: $profile"
  printf '%s' "$profile"
}

assert_socket_path_fits() {
  local profile="$1" socket
  # Longest socket VS Code creates there: "<major.minor, 4 chars>-<type, up to 6 chars>.sock".
  socket="$profile/user-data/0.00-shared.sock"
  # The kernel's limit is in bytes; ${#socket} would count characters in a UTF-8 locale.
  local bytes
  bytes="$(printf '%s' "$socket" | LC_ALL=C /usr/bin/wc -c | tr -d ' ')"
  if [[ $bytes -gt $MAX_SOCKET_PATH ]]; then
    die "the settings path '$profile' is too long for VS Code's IPC socket (macOS allows $MAX_SOCKET_PATH bytes); use a shorter NAME or a shorter CODE_O_WEEN_DATA_ROOT"
  fi
}

keychain_service_for_slug() {
  printf 'Code-o-ween %s' "$1"
}

# Runs a script with the source app's bundled Node (Electron in Node mode). The source app is
# used rather than the copy because the copy's signature is invalid until it is re-signed.
run_bundled_node() {
  local node_app="$1" executable="$2"
  shift 2
  ELECTRON_RUN_AS_NODE=1 "$node_app/Contents/MacOS/$executable" "$@"
}

# Prints the name of a VS Code-style app's command-line launcher (code, codium, ...).
product_application_name() {
  local app="$1" executable="$2" name
  name="$(run_bundled_node "$app" "$executable" -e '
    const product = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(product.applicationName || ""));
  ' "$app/Contents/Resources/app/product.json" 2>/dev/null)" || name=""
  [[ -n "$name" && "$name" != */* && -x "$app/Contents/Resources/app/bin/$name" ]] ||
    die "the source app does not contain the VS Code command-line launcher"
  printf '%s' "$name"
}

# Electron keeps its safeStorage key in the Keychain item "<package.json name> Safe Storage".
# The original "Code Safe Storage" item only trusts Microsoft's signature, so a re-signed copy
# would prompt for it (or be denied and lose logins). A distinct name gives each disguise an
# item it creates and owns.
set_keychain_name() {
  local app="$1" service="$2" node_app="$3" executable="$4"
  COW_PACKAGE_NAME="$service" run_bundled_node "$node_app" "$executable" -e '
    const fs = require("fs");
    const file = process.argv[1];
    const pkg = JSON.parse(fs.readFileSync(file, "utf8"));
    pkg.name = process.env.COW_PACKAGE_NAME;
    fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + "\n");
  ' "$app/Contents/Resources/app/package.json" || die "could not set the Keychain name for this disguise"
}

delete_keychain_item() {
  local service
  service="$(keychain_service_for_slug "$1")"
  if /usr/bin/security delete-generic-password -s "$service Safe Storage" -a "$service Key" >/dev/null 2>&1; then
    note "Deleted Keychain item '$service Safe Storage'."
  fi
}

# ---------------------------------------------------------------------------------------------
# Per-disguise settings kept beside the profile
# ---------------------------------------------------------------------------------------------
read_profile_setting() {
  read_file_or_default "$1/$2" "${3:-}"
}

write_profile_setting() {
  printf '%s' "$3" >"$1/$2"
}

clear_profile_setting() {
  rm -f -- "$1/$2"
}

resolve_folder() {
  local folder="$1" control='[[:cntrl:]]'
  [[ ! "$folder" =~ $control ]] || die "folder paths cannot contain control characters"
  [[ -d "$folder" ]] || die "folder not found: $folder"
  (cd "$folder" && pwd -P)
}

apply_pinned_folder() {
  case "$2" in
    set) write_profile_setting "$1" pinned-folder "$3" ;;
    clear) clear_profile_setting "$1" pinned-folder ;;
  esac
}

# Edits the disguise's settings.json for the window tint, the emoji window title, and the
# update pin. The file is JSONC (JSON with comments), the format VS Code uses: comments and
# trailing commas are allowed, and users keep real notes in it. A plain JSON.parse rejects such
# a file, and a parse-change-serialize round trip would drop every comment and reformat the
# user's settings. So the editor below (JavaScript, run on the app's bundled Node) tokenizes the
# file, locates the exact ranges of the three managed keys, and splices only those, leaving
# everything else byte for byte as the user wrote it. It also handles what VS Code tolerates:
# duplicate keys (the last one wins), empty and comment-only files, a BOM, and settings files
# that are symbolic links in a dotfiles setup. That is why it is as long as it is; the cases it
# covers are the ones tests/window-color.sh exercises.
#
# Usage: apply_window_settings APP PROFILE TINT_OP COLOR TITLE_OP EMOJI [UPDATE_OP]
# UPDATE_OP "set" pins "update.mode" to "none": a disguise must never update itself. VS Code's
# updater would rewrite the clone under its own signature, leaving it unlaunchable and no longer
# matching its recorded source; `code-o-ween refresh` is the only update path for a disguise.
apply_window_settings() {
  local app="$1" profile="$2" tint_op="$3" color="$4" title_op="$5" emoji="$6" update_op="${7:-keep}"
  local executable settings hex="" managed_title result status=0 line
  # The exact title Code-o-ween installed, if any: only that value is ever replaced or removed.
  managed_title="$(read_profile_setting "$profile" window-title)"
  [[ "$tint_op" != keep || "$title_op" != keep || "$update_op" != keep ]] || return 0
  executable="$(read_metadata "$app" executable Code)"
  settings="$profile/user-data/User/settings.json"
  [[ "$tint_op" != set ]] || hex="$(color_hex "$color")"
  local errors_file
  errors_file="$(mktemp "${TMPDIR:-/tmp}/code-o-ween-settings.XXXXXX")"
  result="$(ELECTRON_RUN_AS_NODE=1 "$app/Contents/MacOS/$executable" - "$settings" "$tint_op" "$hex" "$title_op" "$emoji" "$update_op" "$managed_title" 2>"$errors_file" <<'JS'
// Usage: - SETTINGS_FILE TINT_OP HEX TITLE_OP EMOJI UPDATE_OP MANAGED_TITLE   (ops: set | clear | keep)
// MANAGED_TITLE is the window.title Code-o-ween installed earlier, or empty. Prints "title=set"
// or "title=cleared" when it changed the title.
// Edits only "workbench.colorCustomizations", "window.title" and "update.mode" in a VS Code
// settings file (JSON with comments), leaving the rest of the file byte-for-byte intact.
const fs = require("fs");
const path = require("path");
// Arguments follow "-" when the script is read from stdin.
const [file, tintOp, hex, titleOp, emoji, updateOp, managedTitle] = process.argv.slice(process.argv[1] === "-" ? 2 : 1);
const COLORS = "workbench.colorCustomizations";
const TITLE = "window.title";
const UPDATE = "update.mode";
// VS Code's default window.title on macOS.
const DEFAULT_TITLE = "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}${separator}${appName}";

function channel(value) {
  const c = value / 255;
  return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
}
function luminance(color) {
  const n = parseInt(color.slice(1), 16);
  return 0.2126 * channel((n >> 16) & 255) + 0.7152 * channel((n >> 8) & 255) + 0.0722 * channel(n & 255);
}
function foregroundFor(color) {
  const l = luminance(color);
  const contrastWhite = 1.05 / (l + 0.05);
  const contrastDark = (l + 0.05) / (luminance("#1F1F1F") + 0.05);
  return contrastWhite >= contrastDark ? "#FFFFFF" : "#1F1F1F";
}
function managedColors(color) {
  const fg = foregroundFor(color);
  return {
    "titleBar.activeBackground": color,
    "titleBar.activeForeground": fg,
    "titleBar.inactiveBackground": color + "CC",
    "titleBar.inactiveForeground": fg + "99",
    "activityBar.background": color,
    "activityBar.foreground": fg,
    "activityBar.inactiveForeground": fg + "99",
    "activityBar.activeBorder": fg,
    "statusBar.background": color,
    "statusBar.foreground": fg,
  };
}
const MANAGED_KEYS = Object.keys(managedColors("#000000"));

// Calls visit(kind, start, end) for strings, comments, and other characters, in order.
function tokenize(text, visit) {
  for (let i = 0; i < text.length;) {
    const start = i;
    if (text[i] === '"') {
      i++;
      while (i < text.length && text[i] !== '"') i += text[i] === "\\" ? 2 : 1;
      if (i >= text.length) throw new Error("unterminated string");
      visit("string", start, ++i);
    } else if (text.startsWith("//", i)) {
      const n = text.indexOf("\n", i);
      i = n < 0 ? text.length : n;
      visit("comment", start, i);
    } else if (text.startsWith("/*", i)) {
      const n = text.indexOf("*/", i + 2);
      if (n < 0) throw new Error("unterminated comment");
      i = n + 2;
      visit("comment", start, i);
    } else {
      visit("char", start, ++i);
    }
  }
}

function parseJsonc(text) {
  let code = "";
  tokenize(text, (kind, start, end) => { if (kind !== "comment") code += text.slice(start, end); });
  let json = "";
  tokenize(code, (kind, start, end) => {
    if (kind === "char" && code[start] === "," && /^,\s*[}\]]/.test(code.slice(start))) return;
    json += code.slice(start, end);
  });
  return JSON.parse(json);
}

function skipTrivia(text, i) {
  for (;;) {
    if (i < text.length && /\s/.test(text[i])) i++;
    else if (text.startsWith("//", i)) { const n = text.indexOf("\n", i); i = n < 0 ? text.length : n; }
    else if (text.startsWith("/*", i)) { const n = text.indexOf("*/", i + 2); if (n < 0) throw new Error(`unterminated comment at offset ${i}`); i = n + 2; }
    else return i;
  }
}

// Locates the properties of the object that starts at `start` (after trivia) and their value
// ranges. Offsets are absolute, so a nested object is scanned with the same function.
function scanObject(text, start) {
  let i = start;
  const fail = (message) => { throw new Error(`${message} at offset ${i}`); };
  const readString = () => {
    const begin = i++;
    while (i < text.length && text[i] !== '"') i += text[i] === "\\" ? 2 : 1;
    if (i >= text.length) fail("unterminated string");
    i++;
    return JSON.parse(text.slice(begin, i));
  };
  const skipValue = () => {
    i = skipTrivia(text, i);
    const open = text[i];
    if (open === '"') return void readString();
    if (open === "{" || open === "[") {
      const close = open === "{" ? "}" : "]";
      i++;
      for (;;) {
        i = skipTrivia(text, i);
        if (i >= text.length) fail("unexpected end of file");
        if (text[i] === close) { i++; return; }
        if (text[i] === ",") { i++; continue; }
        if (open === "{") {
          if (text[i] !== '"') fail("expected a property name");
          readString();
          i = skipTrivia(text, i);
          if (text[i] !== ":") fail("expected ':'");
          i++;
        }
        skipValue();
      }
    }
    const literal = /^[^,\]}\s/]+/.exec(text.slice(i));
    if (!literal) fail("unexpected token");
    i += literal[0].length;
  };

  i = skipTrivia(text, i);
  if (text[i] !== "{") fail("expected an object");
  const objectStart = i++;
  const properties = [];
  for (;;) {
    i = skipTrivia(text, i);
    if (i >= text.length) fail("unexpected end of file");
    if (text[i] === "}") break;
    if (text[i] === ",") { i++; continue; }
    if (text[i] !== '"') fail("expected a property name");
    const keyStart = i;
    const key = readString();
    i = skipTrivia(text, i);
    if (text[i] !== ":") fail("expected ':'");
    i++;
    i = skipTrivia(text, i);
    const valueStart = i;
    skipValue();
    properties.push({ key, keyStart, valueStart, valueEnd: i });
  }
  const objectEnd = i;
  // The indentation of the first property, for anything added to this object.
  let indent = null;
  if (properties.length) {
    const lineStart = text.lastIndexOf("\n", properties[0].keyStart - 1) + 1;
    const prefix = text.slice(lineStart, properties[0].keyStart);
    if (/^\s*$/.test(prefix)) indent = prefix;
  }
  return { objectStart, objectEnd, end: objectEnd + 1, properties, indent };
}

// The top-level settings object, or null for an empty or comment-only file.
function scan(text) {
  const i = skipTrivia(text, 0);
  if (i >= text.length) return null;
  const settings = scanObject(text, i);
  if (skipTrivia(text, settings.end) < text.length) throw new Error("unexpected content after settings");
  return settings;
}

function serialize(value, indent) {
  return JSON.stringify(value, null, 2).replace(/\n/g, "\n" + indent);
}

// Properties named `key` in `object`, in document order. VS Code keeps the last one, so that is
// the one read and edited; every one of them goes when the key is removed.
function occurrences(object, key) {
  return object.properties.filter((property) => property.key === key);
}

// Removes `property` from `source`, taking its separating comma and, when it was alone on its
// line, the whole line.
function removeProperty(source, property) {
  let start = property.keyStart;
  let end = property.valueEnd;
  const after = skipTrivia(source, property.valueEnd);
  if (source[after] === ",") {
    end = after + 1;
  } else {
    // Last property: take the comma before it when only whitespace separates them.
    const before = source.slice(0, start).replace(/\s*$/, "");
    if (before.endsWith(",")) start = before.length - 1;
  }
  const lineStart = source.lastIndexOf("\n", start - 1) + 1;
  const newline = source.indexOf("\n", end);
  const lineEnd = newline < 0 ? source.length : newline;
  if (/^\s*$/.test(source.slice(lineStart, start)) && /^\s*$/.test(source.slice(end, lineEnd))) {
    start = lineStart;
    end = Math.min(lineEnd + 1, source.length);
  }
  return source.slice(0, start) + source.slice(end);
}

// Sets `key` in `object` (a descriptor from scanObject) to `value`, or removes every occurrence
// when `value` is undefined. Only the managed property changes; the rest of the object, its
// comments included, stays as it was.
function editObject(source, object, key, value, indent) {
  const found = occurrences(object, key);
  if (value === undefined) {
    let result = source;
    for (let remaining = found.length; remaining > 0; remaining--) {
      const current = scanObject(result, object.objectStart);
      result = removeProperty(result, occurrences(current, key).pop());
    }
    return result;
  }
  const entry = `${JSON.stringify(key)}: ${serialize(value, indent)}`;
  const target = found[found.length - 1];
  if (target) return source.slice(0, target.valueStart) + serialize(value, indent) + source.slice(target.valueEnd);
  const last = object.properties[object.properties.length - 1];
  if (!last) {
    const outer = indent.slice(0, Math.max(0, indent.length - 2));
    const inside = source.slice(object.objectStart + 1, object.objectEnd);
    if (/^\s*$/.test(inside)) {
      return source.slice(0, object.objectStart + 1) + `\n${indent}${entry}\n${outer}` + source.slice(object.objectEnd);
    }
    // Only comments inside: keep them, and add the property after them.
    return source.slice(0, object.objectEnd).replace(/\s*$/, "") + `\n${indent}${entry}\n${outer}` + source.slice(object.objectEnd);
  }
  const after = skipTrivia(source, last.valueEnd);
  return source[after] === ","
    ? source.slice(0, after + 1) + `\n${indent}${entry}` + source.slice(after + 1)
    : source.slice(0, last.valueEnd) + `,\n${indent}${entry}` + source.slice(last.valueEnd);
}

// Read through symlinks (dotfile setups); refuse broken links rather than replacing them.
let target = file;
let text = "";
let fileMode = 0o644;
let link = null;
try { link = fs.lstatSync(file); } catch (error) { if (error.code !== "ENOENT") throw error; }
if (link) {
  target = fs.realpathSync(file);
  const stat = fs.statSync(target);
  if (!stat.isFile()) throw new Error(`${target} is not a regular file`);
  fileMode = stat.mode & 0o777;
  text = fs.readFileSync(target, "utf8");
}
const bom = text.startsWith("﻿") ? "﻿" : "";
text = text.slice(bom.length);

// The whole document has to parse before anything is edited; a file VS Code cannot read is left
// exactly as it is. Empty and comment-only files are fine.
if (scan(text) !== null) parseJsonc(text);

// The effective value of a top-level key: the last occurrence, as VS Code reads it.
function readProperty(source, key) {
  const settings = scan(source);
  const property = settings && occurrences(settings, key).pop();
  return property ? parseJsonc(source.slice(property.valueStart, property.valueEnd)) : undefined;
}

function editTopLevel(source, key, value) {
  const settings = scan(source);
  if (!settings) {
    if (value === undefined) return source;
    // Empty or comment-only file: keep the comments.
    const prefix = source.trim() ? source.replace(/\s*$/, "\n") : "";
    return `${prefix}{\n  ${JSON.stringify(key)}: ${serialize(value, "  ")}\n}\n`;
  }
  return editObject(source, settings, key, value, settings.indent ?? "  ");
}

// The last "workbench.colorCustomizations" object, rescanned after every edit because offsets move.
function colorsObject(source) {
  const settings = scan(source);
  const property = settings && occurrences(settings, COLORS).pop();
  if (!property) return null;
  const value = parseJsonc(source.slice(property.valueStart, property.valueEnd));
  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
  const inner = scanObject(source, property.valueStart);
  return { settings, property, inner, indent: inner.indent ?? (settings.indent ?? "  ") + "  " };
}

let output = text;

if (tintOp === "set" || tintOp === "clear") {
  const colors = colorsObject(output);
  if (tintOp === "set") {
    if (!/^#[0-9A-Fa-f]{6}$/.test(hex || "")) throw new Error("expected a #RRGGBB color");
    const managed = managedColors(hex.toUpperCase());
    if (!colors) {
      // Missing, or not an object: write a fresh one.
      output = editTopLevel(output, COLORS, managed);
    } else {
      // Edit the managed keys inside the user's object, so unrelated colors and comments stay.
      for (const [key, value] of Object.entries(managed)) {
        const current = colorsObject(output);
        output = editObject(output, current.inner, key, value, current.indent);
      }
    }
  } else if (colors && MANAGED_KEYS.some((key) => occurrences(colors.inner, key).length)) {
    for (const key of MANAGED_KEYS) {
      const current = colorsObject(output);
      output = editObject(output, current.inner, key, undefined, current.indent);
    }
    // Take the emptied object out only when it is the sole occurrence and holds nothing at all,
    // not even a comment. An earlier duplicate it shadows, or a comment of the user's, keeps it.
    const after = colorsObject(output);
    const inside = output.slice(after.inner.objectStart + 1, after.inner.objectEnd);
    if (after.inner.properties.length === 0 && /^\s*$/.test(inside) && occurrences(after.settings, COLORS).length === 1) {
      output = removeProperty(output, after.property);
    }
  }
} else if (tintOp !== "keep") {
  throw new Error("tint op must be set, clear, or keep");
}

if (titleOp === "set" || titleOp === "clear") {
  const current = readProperty(output, TITLE);
  // Only the exact title Code-o-ween installed counts as ours; "Work ${dirty}..." is the user's.
  const managed = typeof current === "string" && managedTitle !== "" && current === managedTitle;
  if (titleOp === "set") {
    if (!emoji) throw new Error("expected an emoji");
    const wanted = `${emoji} ${DEFAULT_TITLE}`;
    if (current === undefined || current === DEFAULT_TITLE || managed) {
      if (current !== wanted) output = editTopLevel(output, TITLE, wanted);
      console.log("title=set");
    } else {
      console.log("Note: window.title is customized in this disguise's settings, so the emoji is not added to it.");
    }
  } else if (managed) {
    output = editTopLevel(output, TITLE, undefined);
    console.log("title=cleared");
  }
} else if (titleOp !== "keep") {
  throw new Error("title op must be set, clear, or keep");
}

if (updateOp === "set") {
  if (readProperty(output, UPDATE) !== "none") output = editTopLevel(output, UPDATE, "none");
} else if (updateOp !== "keep") {
  throw new Error("update op must be set or keep");
}

if (output === text) process.exit(0);
fs.mkdirSync(path.dirname(target), { recursive: true });
const temp = `${target}.code-o-ween-${process.pid}-${Date.now()}`;
try {
  fs.writeFileSync(temp, bom + output, { flag: "wx", mode: fileMode });
  fs.chmodSync(temp, fileMode);
  fs.renameSync(temp, target);
} catch (error) {
  try { fs.unlinkSync(temp); } catch {}
  throw error;
}
JS
  )" || status=$?
  if [[ $status -ne 0 ]]; then
    # The reason goes to the caller, which decides whether this is fatal; the manager shows
    # only Error: lines, so it must end up in the error and not in a separate warning.
    local reason
    reason="$(/usr/bin/grep -m1 -E '^[A-Za-z]*Error: ' "$errors_file" | /usr/bin/sed -E 's/^[A-Za-z]*Error: //')"
    rm -f -- "$errors_file"
    LAST_SETTINGS_ERROR="could not update the settings in $settings${reason:+: $reason}"
    return 1
  fi
  rm -f -- "$errors_file"
  # The editor reports what it did with the title; everything else it printed is for the user.
  while IFS= read -r line; do
    case "$line" in
      title=set) write_profile_setting "$profile" window-title "$emoji $VSCODE_DEFAULT_TITLE" ;;
      title=cleared) clear_profile_setting "$profile" window-title ;;
      "") ;;
      *) note "$line" ;;
    esac
  done <<<"$result"
}
LAST_SETTINGS_ERROR=""
# VS Code's default window.title on macOS, as the editor knows it.
VSCODE_DEFAULT_TITLE='${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}${separator}${appName}'

